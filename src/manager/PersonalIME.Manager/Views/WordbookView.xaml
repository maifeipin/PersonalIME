<UserControl x:Class="PersonalIME.Manager.Views.WordbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:PersonalIME.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WordbookViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <!-- Main Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search and Action Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="搜索词条: " VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

                <TextBlock Grid.Column="2" Text="方案筛选: " VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding SelectedSchemeFilter}" SelectedValuePath="Tag" Height="28">
                    <ComboBoxItem Content="全部方案" Tag=""/>
                    <ComboBoxItem Content="五笔86" Tag="wubi86"/>
                    <ComboBoxItem Content="全拼" Tag="pinyin"/>
                    <ComboBoxItem Content="双拼" Tag="shuangpin"/>
                    <ComboBoxItem Content="自定义" Tag="custom"/>
                </ComboBox>

                <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshCommand}" Margin="12,0,0,0" Padding="12,4" Height="28"/>

                <Button Grid.Column="6" Content="+ 新增词条" Command="{Binding OpenAddDialogCommand}" Background="#0066CC" Foreground="White" FontWeight="Bold" Padding="14,4" Height="28" Margin="0,0,8,0"/>
                <Button Grid.Column="7" Content="删除选中" Command="{Binding DeleteEntryCommand}" Background="#CC3333" Foreground="White" Padding="12,4" Height="28"/>
            </Grid>

            <!-- Entries DataGrid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplayName}" Width="85"/>
                    <DataGridTextColumn Header="条目 ID" Binding="{Binding Id}" Width="160"/>
                    <DataGridTextColumn Header="词条正文" Binding="{Binding SummaryText}" Width="250"/>
                    <DataGridTextColumn Header="绑定编码" Binding="{Binding FormattedCodes}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑词条" Command="{Binding OpenEditDialogCommand}"/>
                        <MenuItem Header="删除词条" Command="{Binding DeleteEntryCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Pagination Bar -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" VerticalAlignment="Center" Foreground="#555"/>
                <Button Grid.Column="1" Content="上一页" Command="{Binding PrevPageCommand}" Padding="12,4" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="下一页" Command="{Binding NextPageCommand}" Padding="12,4"/>
            </Grid>
        </Grid>

        <!-- Edit/Add Modal Overlay -->
        <Grid Background="#66000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Width="500" Background="White" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#BBB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding EditorTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Word text -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="词条正文 (支持多行、Emoji与特殊字符):" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                    </StackPanel>

                    <!-- Codes list -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <TextBlock Text="编码映射 (至少一个):" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedValue="{Binding NewCodeScheme}" SelectedValuePath="Tag" Height="28">
                                <ComboBoxItem Content="五笔86" Tag="wubi86"/>
                                <ComboBoxItem Content="全拼" Tag="pinyin"/>
                                <ComboBoxItem Content="双拼" Tag="shuangpin"/>
                                <ComboBoxItem Content="自定义" Tag="custom"/>
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding NewCodeText, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="8,0" VerticalContentAlignment="Center" Padding="4,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="添加编码" Command="{Binding AddCodeToDraftCommand}" Padding="10,4" Height="28" Margin="0,0,6,0"/>
                                <Button Content="反查编码" Command="{Binding CheckReverseLookupCommand}" Padding="10,4" Height="28" Background="#F1F3F5"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ReverseLookupPreview}" Foreground="#0066CC" FontSize="12" Margin="0,0,0,6"/>

                        <ListBox ItemsSource="{Binding EditorCodes}" MaxHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SchemeDisplayName}" Foreground="#666"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Code}" FontWeight="SemiBold"/>
                                        <Button Grid.Column="2" Content="移除" Command="{Binding DataContext.RemoveCodeFromDraftCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CloseEditorCommand}" Padding="16,6" Margin="0,0,10,0"/>
                        <Button Content="保存词条" Command="{Binding SaveEditorCommand}" Background="#0066CC" Foreground="White" FontWeight="Bold" Padding="18,6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

