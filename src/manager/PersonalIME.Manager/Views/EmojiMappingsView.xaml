<UserControl x:Class="PersonalIME.Manager.Views.EmojiMappingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="候选框末尾表情联想规则（每页 5 项时为 4 词 + 1 表情）" FontSize="14" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="12,5" Margin="8,0,0,0"/>
                </DockPanel>

                <DataGrid ItemsSource="{Binding Mappings}"
                          SelectedItem="{Binding SelectedMapping}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Binding="{Binding TriggerTypeDisplay}" Width="75"/>
                        <DataGridTextColumn Header="触发编码/首选词" Binding="{Binding TriggerKey}" Width="140"/>
                        <DataGridTextColumn Header="表情" Binding="{Binding Emoji}" Width="75"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Label}" Width="*"/>
                        <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="65"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="新增 / 编辑规则" FontSize="14" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,12"/>

                <TextBlock Text="触发来源类型 (text=首选词精确匹配, code=编码匹配)" Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding TriggerTypes}" SelectedItem="{Binding EditTriggerType}" Margin="0,0,0,10" Padding="8,6"/>

                <TextBlock Text="触发词或编码" Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditTriggerKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="8,6"/>

                <TextBlock Text="表情符号" Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditEmoji, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,0,0,10" Padding="8,4"/>

                <TextBlock Text="说明（可选）" Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="8,6"/>

                <TextBlock Text="优先级（数值越大越优先）" Foreground="#4B5563" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditPriority, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="8,6"/>

                <CheckBox Content="启用此规则" IsChecked="{Binding EditEnabled}" Margin="0,4,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="保存规则" Command="{Binding SaveCommand}" Padding="14,7" Margin="0,0,8,0"/>
                    <Button Content="新建" Command="{Binding NewCommand}" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="删除" Command="{Binding DeleteCommand}" Padding="12,7"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
