<UserControl x:Class="PersonalIME.Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:PersonalIME.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Revision -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="输入引擎与策略配置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="#E9ECEF" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RevisionDisplay}" FontWeight="Bold" Foreground="#495057"/>
                </Border>
            </Grid>

            <!-- Card 1: Basic Input Engine Settings -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="基础输入与候选框" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="主输入方式: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSchemes}" SelectedItem="{Binding PrimaryInputMethod}" Height="28"/>

                        <TextBlock Grid.Column="3" Text="双拼方案布局: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableLayouts}" SelectedItem="{Binding ShuangpinLayout}" Height="28"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="候选词页容量 (5-9):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Slider Grid.Column="1" Minimum="5" Maximum="9" Value="{Binding CandidatePageSize}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding CandidatePageSize}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="（每页显示候选词条数，严格限制为 5 至 9）" Foreground="#777" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="次级补全阈值 (0-9):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="9" Value="{Binding FallbackCandidateThreshold}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding FallbackCandidateThreshold}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="（当主输入法精确候选小于此数量时，自动补充次级输入法候选并附带反查码）" Foreground="#777" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="启用自学习词频调整 (动态靠前)" IsChecked="{Binding FrequencyEnabled}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                        <CheckBox Content="启用新词习惯学习 (学习开关)" IsChecked="{Binding LearningEnabled}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                        <CheckBox Content="启用混输模式 (混输开关)" IsChecked="{Binding MixedInputEnabled}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Initial Modes -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="初始模式状态 (启动或重置时)" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="初始中文输入 (勾选为中文，否则为西文)" IsChecked="{Binding InitialChinese}" Margin="0,0,28,0"/>
                        <CheckBox Content="初始全角字符 (勾选为全角，否则为半角)" IsChecked="{Binding InitialFullWidth}" Margin="0,0,28,0"/>
                        <CheckBox Content="初始中文标点 (勾选为全角标点，否则为半角标点)" IsChecked="{Binding InitialFullPunct}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Priorities - Two Independent Lists (Directive 4) -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="多级优先级调整 (分别独立调整)" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Left: Input Method Priority -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Background="#FAFAFA">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="1. 输入方式优先级与启停" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding MethodPriorities}" SelectedItem="{Binding SelectedMethodPriority}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="▲ 上移" Command="{Binding MoveMethodUpCommand}" Padding="8,4" Margin="0,0,6,0"/>
                                <Button Content="▼ 下移" Command="{Binding MoveMethodDownCommand}" Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Dictionary Priority & Switches -->
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Background="#FAFAFA">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="2. 词库优先级与启停" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding DictionaryPriorities}" SelectedItem="{Binding SelectedDictPriority}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="▲ 上移" Command="{Binding MoveDictUpCommand}" Padding="8,4" Margin="0,0,6,0"/>
                                <Button Content="▼ 下移" Command="{Binding MoveDictDownCommand}" Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: 编码反查联动设置 (Stage 4C-2) -->
            <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="编码反查联动设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="通过不习惯的输入方式找到文字时，在候选条中附带显示目标方案编码（如拼音打字时反查五笔拆码）。提示信息不改变上屏正文、候选排序及自学习。" Foreground="#666666" FontSize="12" Margin="0,0,0,12"/>

                    <CheckBox Content="启用编码反查联动提示" IsChecked="{Binding ReverseLookupEnabled}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid IsEnabled="{Binding ReverseLookupEnabled}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="反查目标输入方式: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableSchemes}" SelectedItem="{Binding ReverseLookupTargetMethod}" Height="28"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="双拼目标布局: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding AvailableLayouts}" SelectedItem="{Binding ReverseLookupShuangpinLayout}" Height="28" IsEnabled="{Binding IsShuangpinTarget}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="反查显示时机: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="编码组合候选窗口即时提示 (当前生效阶段)" VerticalAlignment="Center" Margin="0,10,0,0" Foreground="#2B8A3E" FontWeight="Medium"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 5: Reserved Features (Directive 8) -->
            <Border Grid.Row="5" Background="#F1F3F5" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="高级扩展功能（保留预留项，当前版本未激活）" FontSize="14" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,8"/>
                    <TextBlock Text="注：以下功能严格遵循规范预留，本轮暂不启用或展示为已生效能力。" Foreground="#868E96" FontSize="12" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="实时天气查询插件 (待后续版本实现)" IsEnabled="False" IsChecked="False" Margin="0,0,0,8"/>
                            <CheckBox Content="截图 OCR 识别插件 (待后续版本实现)" IsEnabled="False" IsChecked="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="输入频次统计看板 (待后续版本实现)" IsEnabled="False" IsChecked="False" Margin="0,0,0,8"/>
                            <CheckBox Content="智能情绪辅助提示 (待后续版本实现)" IsEnabled="False" IsChecked="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="重新加载" Command="{Binding LoadPolicyCommand}" Padding="16,8" Margin="0,0,12,0"/>
                <Button Content="保存配置 (并发保护)" Command="{Binding SavePolicyCommand}" Background="#0066CC" Foreground="White" FontWeight="Bold" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

