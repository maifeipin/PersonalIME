<Window x:Class="PersonalIME.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalIME.Manager.ViewModels"
        xmlns:views="clr-namespace:PersonalIME.Manager.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PersonalIME 管理器" Height="700" Width="950" MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Notification Banner -->
        <Border Grid.Row="0" Visibility="{Binding Banner.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#CCCCCC">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#D1ECF1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Banner.Type}" Value="Success">
                            <Setter Property="Background" Value="#D4EDDA"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Banner.Type}" Value="Warning">
                            <Setter Property="Background" Value="#FFF3CD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Banner.Type}" Value="Error">
                            <Setter Property="Background" Value="#F8D7DA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Banner.Message}" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#0C5460"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Banner.Type}" Value="Success">
                                    <Setter Property="Foreground" Value="#155724"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Banner.Type}" Value="Warning">
                                    <Setter Property="Foreground" Value="#856404"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Banner.Type}" Value="Error">
                                    <Setter Property="Foreground" Value="#721C24"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="✕" Command="{Binding Banner.DismissCommand}" Background="Transparent" BorderThickness="0" FontWeight="Bold" Padding="6,2" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Four Tab Views (Wordbook, Sorting, Settings, Maintenance) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="24,10"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="词库">
                <views:WordbookView DataContext="{Binding Wordbook}"/>
            </TabItem>

            <TabItem Header="排序">
                <views:SortingView DataContext="{Binding Sorting}"/>
            </TabItem>

            <TabItem Header="设置">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>

            <TabItem Header="维护">
                <views:MaintenanceView DataContext="{Binding Maintenance}"/>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#28A745"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Foreground" Value="#DC3545"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1" Content="测试连接" Command="{Binding CheckConnectionCommand}" Padding="8,2" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
